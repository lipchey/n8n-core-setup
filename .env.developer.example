# Developer-global settings — copy to .env.developer (gitignored), fill in.
#
# Values are unquoted and use only A-Za-z0-9@._:/+=,- : no spaces, a bare sender address
# (not Name <a@b>), no ? or & in URLs, absolute paths (no ~ or literal $HOME).
# `npm run initialize` stops on anything else and names the key.

# Fine-grained PAT must cover each target repository with Contents: Read and write and Actions: Read.
# Do NOT name it `GITHUB_TOKEN` — GitHub Actions silently blocks that name.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Resend sender address (must be on a verified domain). Used as the default
# for all projects; can be overridden per-project during initialize.sh.
RESEND_FROM_EMAIL=

# healthchecks.io API key — initialize.sh auto-creates a check per project.
HEALTHCHECKS_API_KEY=

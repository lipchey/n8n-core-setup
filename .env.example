# User inputs use paste_<what>_here; wizard-written values use auto_generated; fixed defaults keep their values.
# Values are unquoted and use only A-Za-z0-9@._:/+=,- : no spaces, a bare sender address
# (not Name <a@b>), no ? or & in URLs, absolute paths (no ~ or literal $HOME).
# `npm run initialize` stops on anything else and names the key.

N8N_ENCRYPTION_KEY=auto_generated

N8N_API_KEY=paste_n8n_api_key_here
# WEBHOOK_URL is derived from the domain in .env.config — never set here.
N8N_LOCAL_API_URL=http://localhost:5678/api/v1
# error | warn | info (default) | debug. debug dumps full HTTP — large volume.
N8N_LOG_LEVEL=info

DB_USER=n8n_db_user
DB_PASSWORD=auto_generated
DB_NAME=n8n_database

BACKUP_PASSWORD=auto_generated

# Resend — disk-space + secret-detected alerts. DigitalOcean blocks SMTP, so use HTTP API.
RESEND_API_KEY=paste_resend_api_key_here
RESEND_FROM_EMAIL=paste_sender_email_here

# Dead-man's switch — healthchecks.io Ping URL pinged every 5min.
HEALTH_PING_URL=auto_generated

# Backblaze B2 — second restic snapshot per nightly backup.
BACKBLAZE_KEY_ID=paste_keyID_here
BACKBLAZE_APPLICATION_KEY=paste_applicationKey_here

# Fine-grained PAT with Contents: Read+write and Actions: Read.
# MUST be named GITHUB_PERSONAL_ACCESS_TOKEN — GitHub Actions blocks writing
# GITHUB_TOKEN to $GITHUB_ENV, so the PAT would never reach the VPS.
GITHUB_PERSONAL_ACCESS_TOKEN=paste_github_token_here

# docker-group membership = root anyway, so a non-root user adds nothing here.
N8N_VPS_USER=root
N8N_VPS_IP=auto_generated

# Written automatically by npm run initialize.
N8N_VPS_HOST_FINGERPRINT=auto_generated

# Cloudflare API — only needed for init-cloudflare.sh. Required perms:
#   Account → Cloudflare Tunnel → Edit
#   Account → Access: Apps and Policies → Edit
#   Account → Access: Service Tokens → Edit
#   Account → Account Settings → Read
#   Zone → DNS → Edit
#   Zone → Firewall Services → Edit
#   Zone → WAF → Edit
#   Zone → Transform Rules → Edit
#   User → User Details → Read
CLOUDFLARE_API_TOKEN=paste_cloudflare_api_token_here

# Written automatically by init-cloudflare.sh — Access service-token creds the
# MCP block in initialize.sh stamps into .mcp.json so Claude Code can pass CF Access.
CF_ACCESS_CLIENT_ID=auto_generated
CF_ACCESS_CLIENT_SECRET=auto_generated

# Skips the interactive token prompt in init-digitalocean.sh.
DIGITAL_OCEAN_API_TOKEN=paste_do_api_token_here

# Skips the interactive token prompt in init-hetzner.sh.
HETZNER_API_TOKEN=paste_hetzner_api_token_here

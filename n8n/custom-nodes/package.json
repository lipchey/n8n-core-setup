{
  "name": "@local/n8n-nodes",
  "version": "0.1.0",
  "private": true,
  "description": "Project-local n8n nodes & credentials. Built in CI, mounted into the n8n container via N8N_CUSTOM_EXTENSIONS.",
  "license": "MIT",
  "author": {
    "name": "project"
  },
  "keywords": [
    "n8n-community-node-package"
  ],
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "format": "prettier nodes credentials --write"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ExampleApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Example/Example.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^5.0.1",
    "n8n-workflow": "*",
    "prettier": "^3.9.10",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "lodash": "4.18.1",
    "form-data": "4.0.6",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  }
}
